{
  "name": "InkBoard",
  "short_name": "InkBoard",
  "description": "ホラガイベイのSplatoon 3データを表示・閲覧・分析するWebアプリ",
  "lang": "ja",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
